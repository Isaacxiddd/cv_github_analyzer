{
  "manifest_version": 3,
  "name": "CV ↔ GitHub Analyzer",
  "version": "0.1.0",
  "description": "Cross-check your CV skills against your GitHub profile to detect inconsistencies.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "icons": {
    "16":  "icons/logo_16.png",
    "32":  "icons/logo_32.png",
    "48":  "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CV GitHub Analyzer",
    "default_icon": {
      "16":  "icons/logo_16.png",
      "32":  "icons/logo_32.png",
      "48":  "icons/logo_48.png",
      "128": "icons/logo_128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["portfolio-detector.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.js", "pdf.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
